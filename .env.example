# Copiar a .env en el servidor y llenar. NUNCA subir .env a git.

# Contraseña de la base de datos (nueva, larga)
DB_PASSWORD=

# Clave para firmar las sesiones (mínimo 32 caracteres). Generar con: openssl rand -base64 48
JWT_SECRET=

# Primer administrador: se crea solo si todavía no existe ninguno.
# Después del primer arranque se pueden borrar estas dos líneas.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Puerto público de la app (80 por defecto)
HTTP_PORT=80
